{
  "manifest_version": 3,
  "name": "Saavn Modern & Lyrics Sidekick",
  "version": "2.0.0",
  "description": "Spotify & Apple Music UI overhaul for JioSaavn with time-synced lyrics and a pop-out mini player.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Saavn Modern & Lyrics Sidekick",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://lrclib.net/*",
    "https://*.saavncdn.com/*",
    "https://*.jiosaavn.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.jiosaavn.com/*"
      ],
      "js": [
        "bridge.js"
      ],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://www.jiosaavn.com/*"
      ],
      "js": [
        "lib.js",
        "ui.js",
        "mini.js",
        "content.js"
      ],
      "css": [
        "theme.css",
        "panel.css"
      ],
      "run_at": "document_idle"
    }
  ]
}
